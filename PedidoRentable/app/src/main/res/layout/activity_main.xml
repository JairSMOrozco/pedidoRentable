<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pedido Rentable"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvGananciaDia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hoy: $0.00 / $400"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvProgresoMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0% de la meta"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvRitmoNecesario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ritmo necesario: $57.14/h"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pago mostrado"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etGanancia"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="$"
            android:inputType="numberDecimal"
            android:textSize="22sp"
            android:singleLine="true"
            android:imeOptions="actionNext" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Distancia tienda → cliente"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/etDistanciaCliente"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="km"
            android:inputType="numberDecimal"
            android:textSize="22sp"
            android:singleLine="true"
            android:imeOptions="actionDone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Distancia estimada a tienda:"
            android:textSize="13sp"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tvDistanciaTienda"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2.0 km"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAnalizar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="ANALIZAR"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Esperando pedido..."
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="18dp"
            android:layout_marginTop="10dp" />

        <!-- Se conserva porque MainActivity todavía lo utiliza,
             pero no mostramos cálculos durante la decisión. -->
        <TextView
            android:id="@+id/tvDetalles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAceptar"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="ACEPTÉ"
                android:textStyle="bold"
                android:enabled="false"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnRechazar"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="RECHACÉ"
                android:textStyle="bold"
                android:enabled="false"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnFinalizar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="FINALIZAR PEDIDO"
            android:textStyle="bold"
            android:enabled="false"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/btnCancelarPedido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CANCELAR PEDIDO EN CURSO"
            android:visibility="gone"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tvEstadisticasDia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Finalizados: 0 | Rechazados: 0"
            android:textSize="14sp"
            android:padding="12dp"
            android:layout_marginTop="12dp"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnHistorial"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HISTORIAL"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnConfiguracion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CONFIGURACIÓN"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnCerrarJornada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CERRAR JORNADA"
            android:layout_marginTop="8dp" />


    </LinearLayout>

</ScrollView>